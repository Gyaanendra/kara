{
  "name": "@kara/db",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rmdir /s /q dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node -e \"import('./dist/seed.js').then(m => m.seed())\""
  },
  "dependencies": {
    "@kara/shared-types": "workspace:*",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.23.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.2"
  }
}