# ==========================================
# KARA AI — CENTRALIZED ENVIRONMENT CONFIG
# ==========================================

# --- APP RUNTIME ---
NODE_ENV=development
APP_NAME=Kara
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# --- DATABASE SELECTION ---
# Option A: Ultralight local SQLite (Default for low laptop strain)
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"

# Option B: Cloud PostgreSQL (Switch for staging/production)
# DATABASE_URL="postgresql://kara_user:kara_password@localhost:5432/kara_db?schema=public"
# DATABASE_PROVIDER="postgresql"

# --- VECTOR STORE SELECTION ---
# Options: "chroma" | "qdrant" | "pgvector"
VECTOR_DB_PROVIDER=chroma
CHROMA_URL=http://localhost:8000
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- OBJECT STORAGE (S3 / RUSTFS) ---
# Self-hosted RustFS on Oracle Cloud VPS
S3_ENDPOINT="http://YOUR_ORACLE_IP:PORT"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your_rustfs_access_key"
S3_SECRET_ACCESS_KEY="your_rustfs_secret_key"
S3_BUCKET_NAME="kara-recordings"
S3_FORCE_PATH_STYLE="true"

# --- REDIS (QUEUES & BULLMQ) ---
REDIS_URL="redis://localhost:6379"

# --- AI WORKFLOWS & TRANSCRIPTION ---
GROQ_API_KEY=""
OPENAI_API_KEY=""
MASTRA_MODEL_PROVIDER="openai"

# --- AUTH & SECURITY ---
JWT_SECRET="kara-secret-key-development-only"
JWT_EXPIRATION="7d"

# --- BOT RUNNER CONFIG ---
BOT_USER_AGENT="Kara Bot (kara.ai)"
MAX_MEETING_DURATION_MINUTES=120

